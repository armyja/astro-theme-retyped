---
import { themeConfig } from '../config.ts'

const { title, subtitle } = themeConfig.site
---

<hgroup
  class="cursor-pointer text-center duration-800 ease-in-out flex flex-col gap-2.5 lg:(write-vertical-right items-start b-l-2px b-l-primary text-left)"
>
  <a
    class="not-underline-hover duration-800 ease-in-out lg:px-2.5 lg:pb-12 lg:hover:pt-3.75 lg:hover:pb-8.75 lg:hover:bg-primary lg:hover:text-background"
    href="/"
  >
    <h3 class="text-5 font-extrabold font-header">{subtitle}</h3>
    <h1 class="text-8 font-extrabold font-header">{title}</h1>
  </a>
</hgroup>
