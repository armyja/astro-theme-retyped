---
import type { Post } from '../types'
import { formatDate } from '../utils'
import { t } from '../i18n-util.ts'
import PostTag from './PostTag.astro'

interface Props {
  post: Post
}

const { post } = Astro.props

const tagList = (post.data as any).tags ?? []
---

<header class="flex flex-col gap-2">
  <h1 class="post-title">
    <a class="not-prose" href={`/posts/${post.id}/`}>{post.data.title}</a>
  </h1>
  <div class="text-3.5 flex flex-row flex-wrap items-center gap-x-2 gap-y-1">
    <span>{t(post.data.modDate ? 'updated_at' : 'posted_at')}</span>
    <time>{formatDate(post.data.modDate ?? post.data.pubDate)}</time>
    {tagList.map((tag: string) => <PostTag tag={tag} />)}
  </div>
</header>
