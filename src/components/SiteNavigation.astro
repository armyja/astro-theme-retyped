---
import { themeConfig } from '../config.ts'
import { t } from '../i18n-util.ts'

const { navLinks } = themeConfig.site
---

<nav class="text-center font-bold flex flex-col gap-4">
  <ul class="text-3.5 flex flex-row gap-2 justify-center lg:(flex-col items-start text-4)">
    {
      navLinks.map((nav) => (
        <li>
          <a class="" href={nav.href} target={nav.external ? '_blank' : undefined} rel={nav.external ? 'noopener noreferrer' : undefined}>
            {t(nav.name)}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
